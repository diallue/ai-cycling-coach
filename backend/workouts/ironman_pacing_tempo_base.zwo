<?xml version="1.0" ?>
<workout_file>
  <author>AI Cycling Coach</author>
  <name>Ironman_Pacing_Tempo_Base</name>
  <description>Sesión clave de ritmo Ironman y trabajo de Sweet Spot / Tempo para desarrollar eficiencia aeróbica, resistencia muscular y control de ritmo de carrera.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75"/>
    <SteadyState Duration="300" Power="0.7"/>
    <IntervalsT Repeat="3" OnDuration="720" OffDuration="180" OnPower="0.85" OffPower="0.55"/>
    <SteadyState Duration="900" Power="0.75"/>
    <Cooldown Duration="600" PowerLow="0.7" PowerHigh="0.5"/>
  </workout>
</workout_file>
