<?xml version="1.0" ?>
<workout_file>
  <author>AI Cycling Coach</author>
  <name>Ironman Prep - Sweet Spot 3x15min</name>
  <description>Sesion clave de Sweet Spot (3x15 min a 88% FTP) para construir fuerza resistencia aeróbica y eficiencia metabólica en la fase de preparación Ironman.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75"/>
    <IntervalsT Repeat="3" OnDuration="900" OffDuration="300" OnPower="0.88" OffPower="0.6"/>
    <Cooldown Duration="600" PowerLow="0.7" PowerHigh="0.5"/>
  </workout>
</workout_file>
