<?xml version="1.0" ?>
<workout_file>
  <author>AI Cycling Coach</author>
  <name>VO2Max_5x3min_40min</name>
  <description>Sesión corta de VO2Max: 6 min calentamiento, 5x3 min al 115% FTP con 3 min de recuperación al 50% FTP, y 4 min de enfriamiento. Total: 40 minutos.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.8"/>
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.5"/>
    <Cooldown Duration="240" PowerLow="0.65" PowerHigh="0.45"/>
  </workout>
</workout_file>
