<?xml version="1.0" ?>
<workout_file>
  <author>AI Cycling Coach</author>
  <name>Ironman_Bloque1_OverUnders</name>
  <description>Sesión de Over-Unders metabólicos para elevar el umbral y eficiencia aeróbica previa al bloque específico de volumen Ironman.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75"/>
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.08" OffPower="0.85"/>
    <SteadyState Duration="300" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.08" OffPower="0.85"/>
    <Cooldown Duration="600" PowerLow="0.7" PowerHigh="0.5"/>
  </workout>
</workout_file>
