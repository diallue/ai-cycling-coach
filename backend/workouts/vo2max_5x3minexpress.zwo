<?xml version="1.0" ?>
<workout_file>
  <author>AI Cycling Coach</author>
  <name>VO2Max 5x3minExpress</name>
  <description>Entrenamiento VO2Max de 40 minutos: 6 min calentamiento, 5x(3 min al 115% FTP + 3 min recuperacion al 50% FTP) y 4 min enfriamiento.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="360" PowerLow="0.5" PowerHigh="0.75"/>
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.5"/>
    <Cooldown Duration="240" PowerLow="0.6" PowerHigh="0.45"/>
  </workout>
</workout_file>
