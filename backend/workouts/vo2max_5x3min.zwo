<?xml version="1.0" ?>
<workout_file>
  <author>AI Cycling Coach</author>
  <name>VO2Max 5x3min</name>
  <description>Sesion de VO2Max de 42 minutos: 7 min de calentamiento, 5 series de 3 min al 115% FTP con 3 min de recuperacion activa, y 5 min de enfriamiento.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="420" PowerLow="0.5" PowerHigh="0.75"/>
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.5"/>
    <Cooldown Duration="300" PowerLow="0.7" PowerHigh="0.5"/>
  </workout>
</workout_file>
